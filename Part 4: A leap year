#include <iostream>
using namespace std;

int main() {
    int year;
    cout << "Enter a year: ";
    cin >> year;

    bool isLeap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);//Rules for determining leap years
    //Check whether the input year is a leap year
    if (isLeap) {
        cout << year << " is a leap year." << endl;
    }
    else {
        cout << year << " isn't a leap year." << endl;
    }

    return 0;
}
