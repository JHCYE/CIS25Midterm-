#include <iostream>
using namespace std;

int main() {
    int arr[10];  // Create an integer array of size 10
    int i = 0;

    cout << "Enter ten numbers for the array" << endl;
    // Filling an array using a while loop
    while (i < 10) {
        cin >> arr[i];
        i++;
    }

    // Printing an array using a for loop
    for (int j = 0; j < 10; j++) {
        cout << arr[j] << " ";
    }

    return 0;
}
