#include <iostream>
using namespace std;
int main() {

	int num1; int num2; int num3;
	cout << "Enter the first number, second number and third number ";
	cin >> num1 >> num2 >> num3;//Enter three number

	//Compare the size of three numbers
	if (num1 >= num2)
	{
		if (num1 >= num3)
		{
			cout << "The first number:" << num1 << " is the largest ";
		}
		else
		{
			cout << "The third number: " << num3 << " is the biggest ";
		}

	}
	else if (num2 >= num1)//"else if" can avoid repeated printout when num1 and num2 are equal.
	{
		if (num2 >= num3)
		{
			cout << "The second number: " << num2 << " is the largest ";
		}
		else
		{
			cout << "The third number: " << num3 << " is the largest ";
		}
	}
	return 0;
}
