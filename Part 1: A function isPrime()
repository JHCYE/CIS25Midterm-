#include <iostream>
using namespace std;

bool isPrime(int n)
{
    if (n <= 1)return false;
    if (n == 2)return true;//2 is prime number
    for (int i = 2;i * i <= n;++i)
    {
        if (n % i == 0)
        {
            return false;
        }
    }
    return true;//If all checks pass, then the number is prime
}
int main()
{
    int num1;
    cout << "Enter the number: ";
    cin >> num1;
    cout << num1 << (isPrime(num1) ? " is prime number" : " isn't prime number") << endl;
    return 0;
}
